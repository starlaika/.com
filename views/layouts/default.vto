{{ layout "./base.vto" }}

{{ slot head }}
{{ head }}
{{ /slot }}

<div class="root">
  <div class="content">
    {{ content }}
    <div style="flex:1"><!-- spacing --></div>
    <footer class="main-footer">
      <img alt="&#10;" src="/88x31/Laika.png" style="image-rendering:pixelated" width="88" height="31">
      <p>
        <a href="https://github.com/starlaika/starlaika.github.io">source code</a>
        / updated {{ BUILD_DATE }}
      </p>
    </footer>
  </div>
</div>

{{ slot styles }}
<style>
  .root {
    display: flex;
    justify-content: center;
  }

  .content {
    margin: 0 24px;
    padding: 24px 0;

    display: flex;
    flex-direction: column;
    gap: 16px;

    font-family: ui-monospace, monospace;
    font-size: 14px;
    line-height: 18px;

    width: 100%;
    min-height: 100vh;

    @media (min-width: 720px) {
      width: 720px;
    }

    @media (min-width: 900px) {
      width: 900px;
    }
  }

  .main-footer {
    color: var(--secondary);
    font-size: 10px;
  }
</style>
{{ styles }}
{{ /slot }}
